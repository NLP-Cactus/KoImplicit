{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KoImplicit natural annotation draft",
  "description": "Design v2.0 field specification. Finalize after spoken-corpus audit. Entity/role consistency and future-context validity require human review.",
  "type": "object",
  "required": ["item_id", "conversation_id", "source_release", "document_id", "sentence_id", "predicate_id", "argument_type", "target_speaker_id", "target_addressee_id", "referent_entity_id", "referent_role", "reference_mode", "full_resolvability", "local_resolvability", "split"],
  "properties": {
    "item_id": {"type": "string", "minLength": 1},
    "conversation_id": {"type": "string", "minLength": 1},
    "source_release": {"type": "string"},
    "document_id": {"type": "string"},
    "sentence_id": {"type": "string"},
    "predicate_id": {"type": "string"},
    "argument_type": {"const": "subject"},
    "target_speaker_id": {"type": "string"},
    "target_addressee_id": {"type": ["string", "null"]},
    "referent_entity_id": {"type": ["string", "null"]},
    "referent_role": {"enum": ["speaker", "addressee", "third_party", null]},
    "reference_mode": {"enum": ["textual_anaphoric", "deictic", "mixed", "future_dependent", "uncertain"]},
    "full_resolvability": {"enum": ["unique", "multiple_plausible", "insufficient", "uncertain"]},
    "local_resolvability": {"enum": ["unique", "multiple_plausible", "insufficient", "uncertain", "not_assessed"]},
    "split": {"enum": ["development", "heldout"]},
    "support_spans": {"type": "array", "items": {"type": "object"}},
    "participant_anchor": {"type": ["string", "null"]},
    "distance_unit": {"enum": ["sentence", "turn", "speaker_run_proxy", "unverified"]},
    "last_mention_distance": {"type": ["integer", "null"], "minimum": 0},
    "support_distance": {"type": ["integer", "null"], "minimum": 0},
    "anchor_predicate_id": {"type": ["string", "null"]},
    "anchor_entity_id": {"type": ["string", "null"]},
    "anchor_speaker_id": {"type": ["string", "null"]},
    "entity_switch": {"type": ["boolean", "null"]},
    "speaker_switch": {"type": ["boolean", "null"]},
    "role_switch": {"type": ["boolean", "null"]},
    "target_role_remap": {"type": ["boolean", "null"]},
    "exclusion_reason": {"type": ["string", "null"]},
    "annotator_votes": {"type": "array", "items": {"type": "object"}},
    "adjudication": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"full_resolvability": {"const": "unique"}}},
      "then": {"properties": {"referent_entity_id": {"type": "string", "minLength": 1}, "referent_role": {"enum": ["speaker", "addressee", "third_party"]}, "target_addressee_id": {"type": "string", "minLength": 1}}}
    }
  ]
}
